# ─────────────────────────────────────────────────────────────
# TV Gazeta News — variáveis de ambiente (exemplo)
# Copie para .env.local e preencha quando for conectar serviços.
# NENHUM serviço é conectado na Fase 1 — estas variáveis são apenas
# o contrato preparado para as próximas fases.
# ─────────────────────────────────────────────────────────────

# Supabase (Fase 2+) — fonte de site_settings, auth e storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente no servidor (nunca expor ao cliente):
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do site (metadados/SEO)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# YouTube Data API (OPCIONAL) — reforça a detecção de "AO VIVO".
# Sem esta chave, o site detecta o estado pela página pública do YouTube.
# É SECRETA: apenas no servidor, nunca use o prefixo NEXT_PUBLIC.
YOUTUBE_API_KEY=
